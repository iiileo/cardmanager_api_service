{
  "info": {
    "name": "卡管理 API（分组）",
    "description": "按业务分组：System / Auth / BizTypes / Stores / Staff / CardProducts / Members / Cards / Ledger",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{baseUrl}}"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/healthz",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "发送短信验证码",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/sms/send",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"scene\": \"login\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "验证码登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login/sms",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{sms_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.code === 0 && body.data) {",
                  "  pm.environment.set(\"access_token\", body.data.access_token || \"\");",
                  "  pm.environment.set(\"refresh_token\", body.data.refresh_token || \"\");",
                  "  if (body.data.user && body.data.user.id) {",
                  "    pm.environment.set(\"user_id\", String(body.data.user.id));",
                  "  }",
                  "  console.log(\"已保存 access_token / refresh_token\");",
                  "} else {",
                  "  console.log(\"登录失败，未写入 token\", body);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "刷新 Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/token/refresh",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.code === 0 && body.data) {",
                  "  pm.environment.set(\"access_token\", body.data.access_token || \"\");",
                  "  pm.environment.set(\"refresh_token\", body.data.refresh_token || \"\");",
                  "  console.log(\"已刷新并保存 token\");",
                  "} else {",
                  "  console.log(\"刷新失败\", body);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "退出登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "当前用户",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "response": []
        },
        {
          "name": "修改昵称",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"老板\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "BizTypes",
      "item": [
        {
          "name": "业态列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/biz-types"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Stores",
      "item": [
        {
          "name": "我的门店列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/stores"
          },
          "response": []
        },
        {
          "name": "创建门店",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/stores",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"阳光茶饮 · 人民路店\",\n  \"city\": \"杭州\",\n  \"address\": \"人民路 88 号\",\n  \"open_time\": \"10:00\",\n  \"close_time\": \"22:00\",\n  \"biz_type\": \"tea\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.code === 0 && body.data && body.data.id) {",
                  "  pm.environment.set(\"store_id\", String(body.data.id));",
                  "  if (body.data.invite_code) {",
                  "    pm.environment.set(\"invite_code\", body.data.invite_code);",
                  "  }",
                  "  console.log(\"已保存 store_id=\", body.data.id);",
                  "} else {",
                  "  console.log(\"创建门店失败\", body);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "邀请码预览门店",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/stores/invite/{{invite_code}}"
          },
          "response": []
        },
        {
          "name": "申请加入门店",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/stores/join",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invite_code\": \"{{invite_code}}\",\n  \"nickname\": \"小周\",\n  \"agreed\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "门店详情",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/stores/{{store_id}}"
          },
          "response": []
        },
        {
          "name": "更新门店资料",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/stores/{{store_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"阳光茶饮 · 人民路店\",\n  \"city\": \"杭州\",\n  \"address\": \"人民路 88 号\",\n  \"open_time\": \"10:00\",\n  \"close_time\": \"22:00\",\n  \"biz_type\": \"tea\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "查看邀请码",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/stores/{{store_id}}/invite-code"
          },
          "response": []
        },
        {
          "name": "刷新邀请码",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/stores/{{store_id}}/invite-code/refresh"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Staff",
      "item": [
        {
          "name": "在职员工列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/staff"
          },
          "response": []
        },
        {
          "name": "待审核申请",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/staff/applications"
          },
          "response": []
        },
        {
          "name": "同意入店申请",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/staff/applications/{{member_id}}/approve"
          },
          "response": []
        },
        {
          "name": "拒绝入店申请",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/staff/applications/{{member_id}}/reject"
          },
          "response": []
        }
      ],
      "description": "需 X-Store-Id"
    },
    {
      "name": "CardProducts",
      "item": [
        {
          "name": "卡种列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/card-products",
            "description": "可选 query type=value|count|pack"
          },
          "response": []
        },
        {
          "name": "新建卡种",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/card-products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"pack\",\n  \"name\": \"洗剪吹护理套餐\",\n  \"price\": 39800,\n  \"valid_months\": 12,\n  \"items\": [\n    { \"name\": \"洗\", \"times\": 10 },\n    { \"name\": \"剪\", \"times\": 10 },\n    { \"name\": \"护理\", \"times\": 5 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "老板。value/count 各只能一个；pack 可多个"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.code === 0 && body.data && body.data.id) {",
                  "  pm.environment.set(\"product_id\", String(body.data.id));",
                  "  console.log(\"已保存 product_id=\", body.data.id);",
                  "} else {",
                  "  console.log(\"创建卡种失败\", body);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "删除卡种",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/card-products/{{product_id}}"
          },
          "response": []
        }
      ],
      "description": "需 X-Store-Id；新建/删除仅老板"
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "会员列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/members?q="
          },
          "response": []
        },
        {
          "name": "会员详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/members/{{member_id}}"
          },
          "response": []
        },
        {
          "name": "开卡",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/members/cards",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"李明\",\n  \"phone\": \"13987654321\",\n  \"product_id\": \"{{product_id}}\",\n  \"source\": \"walk_in\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.code === 0 && body.data && body.data.card) {",
                  "  pm.environment.set(\"card_id\", String(body.data.card.id));",
                  "  pm.environment.set(\"member_id\", String(body.data.member.id));",
                  "  if (body.data.card.items && body.data.card.items.length > 0) {",
                  "    pm.environment.set(\"pack_item_id_1\", String(body.data.card.items[0].id));",
                  "  }",
                  "  if (body.data.card.items && body.data.card.items.length > 1) {",
                  "    pm.environment.set(\"pack_item_id_2\", String(body.data.card.items[1].id));",
                  "  }",
                  "  console.log(\"已保存 card_id / member_id / pack_item_id\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "会员名下卡列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/members/{{member_id}}/cards"
          },
          "response": []
        }
      ],
      "description": "需 X-Store-Id"
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "卡详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/cards/{{card_id}}"
          },
          "response": []
        },
        {
          "name": "充值",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/cards/{{card_id}}/recharge",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "仅储值卡"
          },
          "response": []
        },
        {
          "name": "扣除（支持套餐多项）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/cards/{{card_id}}/consume",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"item_id\": \"{{pack_item_id_1}}\", \"times\": 1 },\n    { \"item_id\": \"{{pack_item_id_2}}\", \"times\": 1 }\n  ],\n  \"remark\": \"一次扣多项\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "套餐 items 多项；兼容 item_id 单项目；储值 amount；次卡 times"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.code === 0 && body.data && body.data.ledger_id) {",
                  "  pm.environment.set(\"ledger_id\", String(body.data.ledger_id));",
                  "  console.log(\"已保存 ledger_id=\", body.data.ledger_id);",
                  "}"
                ]
              }
            }
          ]
        }
      ],
      "description": "需 X-Store-Id"
    },
    {
      "name": "Ledger",
      "item": [
        {
          "name": "流水列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/ledger?type=&from=&to=&page=1"
          },
          "response": []
        },
        {
          "name": "流水详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Store-Id",
                "value": "{{store_id}}",
                "description": "当前门店 ID"
              }
            ],
            "url": "{{baseUrl}}/api/v1/ledger/{{ledger_id}}",
            "description": "套餐扣除含 items 明细"
          },
          "response": []
        }
      ],
      "description": "需 X-Store-Id"
    }
  ]
}