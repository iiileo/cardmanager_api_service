# 仅给 docker compose 用。复制为 .env 后按需修改：
#   cp .env.example .env
#   docker compose up -d --build
#
# 本文件中的短名会被 docker-compose.yml 映射成容器内 CM_*。
# 本地开发请改 internal/config/config.yaml，不要依赖本文件。

# --- 外部 PostgreSQL ---
# 连宿主机：host.docker.internal（compose 已配 extra_hosts）
# 连局域网/云库：改成实际地址；云库建议 SSLMODE=require
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=card_manager
POSTGRES_SSLMODE=disable

# --- API 宿主机映射端口 ---
API_PORT=8080

# --- 服务 / 日志 ---
SERVER_MODE=local
LOG_LEVEL=info

# --- 认证 ---
JWT_SECRET=card-manager-docker-dev-secret-change-me
# ACCESS_TTL_SECONDS=7200
# REFRESH_TTL_SECONDS=2592000

# --- 短信 ---
# true：不真正发短信，响应可带 data.dev_code
# false + SMS_PROVIDER=spug：Spug 真实发送 https://push.spug.cc/guide/sms
SMS_DEV_MODE=true
SMS_DEV_CODE=123456
# SMS_CODE_TTL_SECONDS=300
# SMS_PROVIDER=dev
# SMS_PROVIDER=spug
# SMS_SPUG_TEMPLATE_CODE=
# SMS_SPUG_WITH_TTL=true
