# 复制为 .env 后按需修改。
#   cp .env.example .env
#
# 用法：
#   1) docker compose：本文件里的「短名」变量会被 compose 注入为 CARDMANAGER_*（见 docker-compose.yml）
#   2) 本地 go run：请使用下方「CARDMANAGER_*」全名（godotenv + Viper AutomaticEnv）
#
# 命名规则：前缀 CARDMANAGER_ + 配置路径大写，点改下划线
#   auth.sms_provider → CARDMANAGER_AUTH_SMS_PROVIDER
# 默认值见 internal/config/config.yaml（本地）或 config.docker.yaml（镜像）

# ========== Docker Compose 短名（compose 会映射到 CARDMANAGER_*）==========

# --- 外部 PostgreSQL ---
# 连宿主机：host.docker.internal（compose 已配 extra_hosts）
# 连局域网/云库：改成实际地址；云库建议 SSLMODE=require
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=card_manager
POSTGRES_SSLMODE=disable

# --- API 宿主机映射端口 ---
API_PORT=8080

# --- 服务 / 日志 ---
SERVER_MODE=local
LOG_LEVEL=info

# --- 认证 ---
JWT_SECRET=card-manager-docker-dev-secret-change-me
# access / refresh TTL（秒）；不设则用 config.yaml 默认
# ACCESS_TTL_SECONDS=7200
# REFRESH_TTL_SECONDS=2592000

# --- 短信 ---
# true：不真正发短信，成功响应可带 data.dev_code（联调）
# false + SMS_PROVIDER=spug：走 Spug 真实发送 https://push.spug.cc/guide/sms
SMS_DEV_MODE=true
SMS_DEV_CODE=123456
# SMS_CODE_TTL_SECONDS=300
# SMS_PROVIDER=dev
# SMS_PROVIDER=spug
# SMS_SPUG_TEMPLATE_CODE=
# SMS_SPUG_WITH_TTL=true

# ========== 本地 go run 用 CARDMANAGER_*（与 config 路径一一对应）==========
# 取消注释后会覆盖 config.yaml 中同名项。

# --- server ---
# CARDMANAGER_SERVER_ADDRESS=:8080
# CARDMANAGER_SERVER_MODE=local

# --- postgres ---
# CARDMANAGER_POSTGRES_HOST=127.0.0.1
# CARDMANAGER_POSTGRES_PORT=5432
# CARDMANAGER_POSTGRES_USER=postgres
# CARDMANAGER_POSTGRES_PASSWORD=postgres
# CARDMANAGER_POSTGRES_DBNAME=card_manager
# CARDMANAGER_POSTGRES_SSLMODE=disable

# --- logging ---
# CARDMANAGER_LOGGING_LEVEL=info

# --- auth ---
# CARDMANAGER_AUTH_JWT_SECRET=change-me
# CARDMANAGER_AUTH_ACCESS_TTL_SECONDS=7200
# CARDMANAGER_AUTH_REFRESH_TTL_SECONDS=2592000
# CARDMANAGER_AUTH_SMS_CODE_TTL_SECONDS=300
# CARDMANAGER_AUTH_SMS_DEV_CODE=123456
# CARDMANAGER_AUTH_SMS_DEV_MODE=true
# CARDMANAGER_AUTH_SMS_PROVIDER=dev
# # 生产示例：
# # CARDMANAGER_AUTH_SMS_DEV_MODE=false
# # CARDMANAGER_AUTH_SMS_PROVIDER=spug
# # CARDMANAGER_AUTH_SMS_SPUG_TEMPLATE_CODE=从 Spug 控制台复制的模板编码
# # CARDMANAGER_AUTH_SMS_SPUG_WITH_TTL=true

# --- access_log（一般保持 yaml 默认即可）---
# CARDMANAGER_ACCESS_LOG_ENABLED=true
# CARDMANAGER_ACCESS_LOG_FILE_PATH=data/access.jsonl
# CARDMANAGER_ACCESS_LOG_MAX_MEMORY=300
# CARDMANAGER_ACCESS_LOG_MAX_BODY_BYTES=8192
# CARDMANAGER_ACCESS_LOG_UI_ENABLED=true
# CARDMANAGER_ACCESS_LOG_UI_PATH=/debug/access-logs
