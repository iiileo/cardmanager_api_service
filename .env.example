# 复制为 .env 后供 docker compose 读取（可选）。

# ---------- 外部 PostgreSQL ----------
# 连宿主机：host.docker.internal（compose 已配 extra_hosts）
# 连局域网/云库：改成实际地址
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=card_manager
POSTGRES_SSLMODE=disable

# ---------- API ----------
API_PORT=8080

# ---------- 其他（CARDMANAGER_ 前缀，点改下划线）----------
# JWT_SECRET=your-production-secret
# SMS_DEV_MODE=false
# SERVER_MODE=release
# LOG_LEVEL=info
